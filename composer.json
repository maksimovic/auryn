{
    "name": "maksimovic/auryn",
    "homepage": "https://github.com/maksimovic/auryn",
    "description": "PHP 8.1-8.5 compatible fork of rdlowrey/auryn — a dependency injector for bootstrapping object-oriented PHP applications.",
    "keywords": ["dependency injection", "dic", "ioc"],
    "license": "MIT",
    "authors": [
        {
            "name": "Daniel Lowrey",
            "email": "rdlowrey@gmail.com",
            "role": "Creator / Main Developer",
            "homepage": "https://github.com/rdlowrey"
        },
        {
            "name": "Levi Morrison",
            "email": "levim@php.net",
            "homepage": "http://morrisonlevi.github.com/",
            "role": "Developer"
        },
        {
            "name": "Dan Ackroyd",
            "email": "Danack@basereality.com",
            "homepage": "http://www.basereality.com",
            "role": "Developer"
        },
        {
            "name": "Oliver Maksimovic",
            "email": "maksimovic@mukuru.com",
            "role": "Fork Maintainer",
            "homepage": "https://github.com/maksimovic"
        }
    ],
    "replace": {
        "rdlowrey/auryn": "^1.4.4"
    },
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "Auryn\\": "lib/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Auryn\\": "test/"
        },
        "files": ["test/fixtures.php"]
    }
}
